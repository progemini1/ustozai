# Copy these names to server-only .env or Render Environment settings.
# Never use a VITE_ prefix for private provider credentials.
GROQ_API_KEY=
GROQ_API_KEY_BACKUP=
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=

# Optional model overrides. Verify that the account can access the chosen model.
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional deadlines, milliseconds. Default 8000 per attempt, 25000 total.
AI_ATTEMPT_TIMEOUT_MS=8000
AI_TOTAL_TIMEOUT_MS=25000
